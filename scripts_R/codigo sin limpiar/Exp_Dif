graficar_gen_estrella <- function(dds, gene_id, variable_x = "Temporada") {
  
  d <- plotCounts(dds, gene = gene_id, intgroup = variable_x, returnData = TRUE)
  
  ggplot(d, aes_string(x = variable_x, y = "count", fill = variable_x)) +
    geom_boxplot(outlier.shape = NA, alpha = 0.7) +
    geom_jitter(width = 0.2, size = 2) +
    scale_y_log10() + 
    theme_minimal() +
    labs(title = paste("Expresión de:", gene_id),
         y = "Conteos Normalizados (log10)", x = "") +
    scale_fill_brewer(palette = "Set1")
}

