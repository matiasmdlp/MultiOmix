
library(readxl)

prot_data <- read_excel("matrix_proteomico.xlsx")

prot_raw <- as.data.frame(prot_data)

rownames(prot_raw) <- prot_raw[, 1] 

columnas_muestras <- grep("Muestra", colnames(prot_raw))
prot_matrix <- prot_raw[, columnas_muestras]

print(paste("Proteínas detectadas:", nrow(prot_matrix)))
print(paste("Muestras detectadas:", ncol(prot_matrix)))
head(prot_matrix[, 1:3]) 


