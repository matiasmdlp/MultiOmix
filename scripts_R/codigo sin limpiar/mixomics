---------------------------------------------------------------------------------

library(SummarizedExperiment)
library(mixOmics)

varianzas <- apply(assay(vsd), 1, var)
top_genes <- names(sort(varianzas, decreasing = TRUE)[1:3000])
X_rna <- t(assay(vsd)[top_genes, ])

X_prot_final <- X_prot_final[rownames(X_rna), ]

if(all(rownames(X_rna) == rownames(X_prot_final))){
  print("¡Alineación perfecta! Listos para MixOmics.")
} else {
  print("Error: Las muestras no coinciden.")
}

X <- list(mRNA = X_rna, 
          Proteinas = X_prot_final)

Y <- metadata$Temporada


---------------------------------------------------------------------------------
---------------------------------------------------------------------------------

design <- matrix(0.1, ncol = length(X), nrow = length(X), 
                 dimnames = list(names(X), names(X)))
diag(design) <- 0

modelo_diablo <- block.plsda(X = X, Y = Y, ncomp = 2, design = design)

plotIndiv(modelo_diablo, 
          ind.names = FALSE, 
          legend = TRUE, 
          title = 'DIABLO: Transcriptómica y Proteómica por Temporada')


---------------------------------------------------------------------------------
---------------------------------------------------------------------------------

plotDiablo(modelo_diablo, ncomp = 1)


plotArrow(modelo_diablo, ind.names = FALSE, legend = TRUE, 
          title = 'Acuerdo por muestra: ARN vs Proteínas')


circosPlot(modelo_diablo, cutoff = 0.7, line = TRUE, 
           color.blocks = c('darkorchid', 'lightgreen'),
           color.cor = c("chocolate3", "grey20"), size.variables = 0.5)

---------------------------------------------------------------------------------
---------------------------------------------------------------------------------

biomarcadores_rna <- selectVar(modelo_diablo, block = 'mRNA', comp = 1)$mRNA$value
biomarcadores_prot <- selectVar(modelo_diablo, block = 'Proteinas', comp = 1)$Proteinas$value

top_genes <- biomarcadores_rna[order(abs(biomarcadores_rna$value.var), decreasing = TRUE), , drop = FALSE]
top_proteinas <- biomarcadores_prot[order(abs(biomarcadores_prot$value.var), decreasing = TRUE), , drop = FALSE]

print("Top 15 Genes que definen la Temporada:")
head(top_genes, 15)

print("Top 15 Proteínas que definen la Temporada:")
head(top_proteinas, 15)

write.csv(top_genes, file = "Top_Biomarcadores_RNA_DIABLO.csv")
write.csv(top_proteinas, file = "Top_Biomarcadores_Proteinas_DIABLO.csv")


