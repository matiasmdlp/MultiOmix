volcano_xlim <- c(-20, 20)  # Rango para log2FoldChange
volcano_ylim <- c(0, 45)    # Rango para -log10(p-value)

# Creamos una funcion para crear graficos Volcano

library(EnhancedVolcano)

generar_reporte_volcano <- function(dds, nombre_contraste) {
  
  message(paste("Procesando:", nombre_contraste))
  
  # Extraer resultados
  res <- results(dds, name = nombre_contraste)
  
  # Guardar tabla de datos completa en CSV
  write.csv(as.data.frame(res), file = paste0("Tabla_Resultados_", nombre_contraste, ".csv"))
  
  # Generar el Volcano Plot 
  p <- EnhancedVolcano(res,
    lab = rownames(res),
    x = 'log2FoldChange',
    y = 'padj', 
    title = paste("Contraste:", nombre_contraste),
    subtitle = "Datos Hologenómicos Completos",
    pCutoff = 0.05,
    FCcutoff = 1,
    xlim = volcano_xlim,
    ylim = volcano_ylim,
    pointSize = 1.5,
    labSize = 3.0,
    col = c('grey', 'forestgreen', 'royalblue', 'red3'),
    colAlpha = 0.5,
    legendPosition = 'right',
    legendLabSize = 10,
    drawConnectors = TRUE,
    widthConnectors = 0.5) +
    coord_cartesian(expand = FALSE) 
  
  # 4. Guardar el gráfico 
  ggsave(filename = paste0("Volcano_", nombre_contraste, ".png"), 
         plot = p, width = 10, height = 8, dpi = 300)
  
  return(res)
}

