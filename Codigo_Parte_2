# install.packages("readxl")
library(readxl)

# 1. Leer el archivo Excel
# read_excel no permite asignar row.names directamente por cómo estructura los datos (tibble)
prot_data <- read_excel("matrix_proteomico.xlsx")

# 2. Convertir a Data Frame tradicional para poder manipular los nombres de las filas
prot_raw <- as.data.frame(prot_data)

# 3. Asignar la primera columna (Protein.Group) como nombre de las filas
rownames(prot_raw) <- prot_raw[, 1] # Asume que la columna 1 es Protein.Group

# 4. Extraer SOLO las columnas numéricas de tus muestras
# grep buscará cualquier columna que contenga la palabra "Muestra"
columnas_muestras <- grep("Muestra", colnames(prot_raw))
prot_matrix <- prot_raw[, columnas_muestras]

# 5. Verificamos que se haya cargado bien
print(paste("Proteínas detectadas:", nrow(prot_matrix)))
print(paste("Muestras detectadas:", ncol(prot_matrix)))
head(prot_matrix[, 1:3]) # Ver una esquinita de los datos numéricos


---------------------------------------------------------------------------------
---------------------------------------------------------------------------------


# 1. Sincronizamos el orden de las columnas con la metadata
# Esto asegura que Muestra01 esté en la posición 1 tanto en ARN como en Proteínas
prot_matrix <- prot_matrix[, rownames(metadata)]

# 2. Comprobamos los "NAs" (Valores perdidos)
total_NAs <- sum(is.na(prot_matrix))
print(paste("Total de NAs en la matriz de proteínas:", total_NAs))

# 3. Transponemos la matriz para MixOmics
# Filas = Muestras, Columnas = Variables
X_prot <- t(prot_matrix)

# 4. Chequeamos la escala de los valores
# Si el número máximo es algo como 30, ya está en logaritmo. 
# Si es un número gigante (millones), tendremos que transformarlo luego.
print("Resumen de valores de abundancia proteica:")
summary(as.vector(X_prot))[c("Min.", "Max.", "Median")]


---------------------------------------------------------------------------------
---------------------------------------------------------------------------------


# 1. FILTRADO DE PROTEÍNAS CON DEMASIADOS NAs
# Calculamos qué porcentaje de NAs tiene cada proteína
porcentaje_NAs <- apply(prot_matrix, 1, function(x) sum(is.na(x)) / length(x))

# Nos quedamos SOLO con las proteínas que tengan menos del 30% de NAs
# (Es decir, que aparezcan en al menos el 70% de las muestras)
prot_filtrada <- prot_matrix[porcentaje_NAs < 0.30, ]
print(paste("Proteínas tras filtrar NAs:", nrow(prot_filtrada)))

# 2. TRANSFORMACIÓN LOGARÍTMICA
# Suavizamos los valores de millones a una escala manejable (como hicimos con el ARN)
prot_log2 <- log2(prot_filtrada)

# 3. IMPUTACIÓN (Rellenar los NAs restantes)
# En proteómica, un NA suele significar que la proteína estaba en una cantidad 
# tan baja que la máquina no la vio. Reemplazamos los NAs con el valor MÍNIMO 
# detectado para esa proteína (Límite de Detección).
X_prot_final <- apply(prot_log2, 1, function(x) {
  # Buscamos el valor mínimo de esa proteína
  minimo_prot <- min(x, na.rm = TRUE)
  # Reemplazamos los NAs con ese mínimo
  x[is.na(x)] <- minimo_prot
  return(x)
})

# Nota importante de R: Al usar apply por filas, R automáticamente transpone 
# el resultado. ¡Así que X_prot_final ya tiene las Muestras en las FILAS!


