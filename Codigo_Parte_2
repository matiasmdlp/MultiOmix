X_rna <- t(assay(vsd)[top_genes, ])

# 2. Aseguramos que ambas matrices tengan exactamente el mismo orden de muestras
X_prot_final <- X_prot_final[rownames(X_rna), ]

# 3. Verificación de oro: ¿Son idénticos los nombres de las filas?
if(all(rownames(X_rna) == rownames(X_prot_final))){
  print("¡Alineación perfecta! Listos para MixOmics.")
} else {
  print("Error: Las muestras no coinciden.")
}

# 4. Creamos el objeto X (la lista de bloques ómicos) y la Y (lo que queremos predecir)
X <- list(mRNA = X_rna, 
          Proteinas = X_prot_final)

# Para este primer análisis integrador, veamos cómo el clima afecta al hologenoma
Y <- metadata$Temporada


---------------------------------------------------------------------------------
---------------------------------------------------------------------------------


# 1. Matriz de Diseño (Design)
# Le decimos a DIABLO que busque una correlación entre ARN y Proteínas 
# (0.1 es el estándar inicial para que no fuerce correlaciones falsas)
design <- matrix(0.1, ncol = length(X), nrow = length(X), 
                 dimnames = list(names(X), names(X)))
diag(design) <- 0

# 2. Correr el modelo inicial (Usamos 2 componentes o dimensiones)
modelo_diablo <- block.plsda(X = X, Y = Y, ncomp = 2, design = design)

# 3. Gráfico de dispersión integrador (El equivalente al PCA, pero multiómico)
plotIndiv(modelo_diablo, 
          ind.names = FALSE, 
          legend = TRUE, 
          title = 'DIABLO: Transcriptómica y Proteómica por Temporada')


